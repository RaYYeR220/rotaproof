{
  "name": "rotaproof",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @rotaproof/web dev",
    "build": "pnpm --filter @rotaproof/web build",
    "start": "pnpm --filter @rotaproof/web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webmcp": "node tests/webmcp.harness.mjs",
    "evals": "node scripts/run-evals.mjs",
    "verify:receipt": "node scripts/verify-receipt.mjs",
    "typecheck": "tsc -b --pretty false",
    "check": "pnpm typecheck && pnpm test && pnpm verify:receipt"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "highs": "^1.15.2"
  }
}
