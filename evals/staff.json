            {
              "day": 1,
              "shift": "mid"
            },
            {
              "day": 1,
              "shift": "close"
            }
          ]
        }
      }
    ]
  },
  {
    "name": "Finding out who could cover a shift",
    "messages": [
      {
        "role": "user",
