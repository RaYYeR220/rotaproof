            }
          ]
        }
      }
    ]
  },
  {
    "name": "Asking for a whole day rather than one shift",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "I need all of Tuesday off."
      }
    ],
    "expectedCall": [
      {
        "functionName": "request_time_off",
        "arguments": {
          "slots": [
            {
              "day": 1,
              "shift": "open"
