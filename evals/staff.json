      }
    ],
    "expectedCall": [
      {
        "functionName": "my_shifts",
        "arguments": {}
      }
    ]
  },
  {
    "name": "Asking for a day off",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Can I have the Wednesday evening off? My sister is visiting."
      }
    ],
    "expectedCall": [
